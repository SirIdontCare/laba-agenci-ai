# Kopiuj jako .env.local. Nigdy nie commituj wartości sekretów.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_QUALITY=
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_IMAGE=
OPENROUTER_MODEL_EMBEDDING=
# Wypełnij po próbie modelu embeddingowego; schema SQL musi się zgadzać.
EMBEDDING_DIMENSIONS=
# Unikalna długa fraza demonstracyjna L01-L04; nie klucz OpenRouter.
COURSE_ACCESS_TOKEN=
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
# Proponowane limity aplikacji, nie limity planu OpenRouter.
MAX_MODEL_STEPS=6
MAX_TOOL_CALLS=8
RUN_TIMEOUT_MS=45000
MAX_OUTPUT_TOKENS=1500
# Supabase od L05; nowe publishable keys lub zgodne anon keys według projektu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cron/webhook od L09: dwa różne sekrety.
CRON_SECRET=
WEBHOOK_SECRET=
